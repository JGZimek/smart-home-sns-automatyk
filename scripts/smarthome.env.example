# ==========================================================
# Smart Home RPi – konfiguracja serwera (tunable)
# ==========================================================
# Ten plik to WZORZEC wartosci domyslnych. Setup kopiuje go do
# /etc/smarthome/smarthome.env (jesli jeszcze nie istnieje) i NIE nadpisuje
# Twoich zmian przy ponownym uruchomieniu. Edytuj /etc/smarthome/smarthome.env,
# a nastepnie: sudo smarthome update  (albo restart konkretnej uslugi).
#
# Format: KLUCZ=wartosc (bez spacji wokol =). Bez polskich znakow.

# --- Tozsamosc serwera / mDNS (MUSI byc 'rpi-smarthome' – firmware tego szuka) ---
HOSTNAME=rpi-smarthome

# --- Konto brokera MQTT (firmware loguje sie 'esp32'/'esp32' – nie zmieniaj bez zmiany firmware) ---
BROKER_USER=esp32
BROKER_PASS=esp32
MQTT_PORT=1883

# --- Web status (dashboard wezlow, podglad przez Tailscale/LAN) ---
WEB_ENABLE=1
WEB_PORT=8080

# --- Monitor wezlow ESP ---
# Lista rodzajow, ktore POWINNY byc obecne (brak = oznaczany jako MISSING w dashboardzie).
EXPECTED_KINDS=security,access,environment
# Po ilu sekundach bez heartbeatu (home/<kind>/diag co 30s) wezel uznajemy za 'stale'.
DIAG_STALE_S=90

# --- Awaryjny Access Point Wi-Fi (gdy Pi nie ma polaczenia z siecia) ---
AP_FALLBACK_ENABLE=1
AP_SSID=SmartHome-Config
# Haslo do AP. PUSTE = siec otwarta. WPA2 wymaga min. 8 znakow.
AP_PASS=
# Ile sekund braku polaczenia LAN zanim podniesiemy AP.
AP_GRACE_S=90

# --- Wyswietlacz LCD I2C (opcjonalny) ---
# auto = wlacz tylko jesli wykryto urzadzenie I2C; 1 = wymus; 0 = wylacz.
LCD_ENABLE=auto
LCD_I2C_ADDR=0x27

# --- Tailscale (zdalny dostep SSH bez przekierowania portow) ---
TAILSCALE_ENABLE=1
# Wlacz Tailscale SSH (logowanie po SSH przez siec tailnet).
TAILSCALE_SSH=1
# Pre-auth key z https://login.tailscale.com/admin/settings/keys – jesli ustawiony,
# logowanie jest bezinteraktywne (pelne plug-and-play). Pusty = link do zalogowania w konsoli.
TAILSCALE_AUTHKEY=
# Tagi ACL dla tego wezla (np. 'tag:smarthome'). Ulatwia regule dla CI/OTA z GitHub Actions.
# Wymaga wpisu w tagOwners w ACL tailnetu. Pusty = wezel przypisany do Twojego konta.
TAILSCALE_TAGS=
