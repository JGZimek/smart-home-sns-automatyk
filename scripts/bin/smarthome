#!/usr/bin/env bash
# ==========================================================
# smarthome – CLI do zarzadzania serwerem i wezlami ESP
# ==========================================================
# Wygodna nakladka na mosquitto/docker/systemd – sterowanie i diagnostyka
# przez SSH/Tailscale. Wymaga zainstalowanego serwera (setup.sh).
set -euo pipefail

# Znajdz katalog skryptow (symlink-aware) i zaladuj wspolna biblioteke.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do SRC="$(readlink "$SRC")"; done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"
# shellcheck source=../lib/common.sh
. "$BIN_DIR/../lib/common.sh"
load_config

B_HOST="localhost"
B_USER="${BROKER_USER:-smarthome}"
B_PASS="${BROKER_PASS:-smarthome}"
B_PORT="${MQTT_PORT:-1883}"
NODES_JSON="$STATE_DIR/nodes.json"

mq_pub() { mosquitto_pub -h "$B_HOST" -p "$B_PORT" -u "$B_USER" -P "$B_PASS" "$@"; }
mq_sub() { mosquitto_sub -h "$B_HOST" -p "$B_PORT" -u "$B_USER" -P "$B_PASS" "$@"; }

# IP serwera w sieci LAN (osiagalny dla ESP). Najpierw zrodlo trasy domyslnej,
# potem fallback na hostname -I z odfiltrowaniem docker (172.16-31.*) i tailscale (100.*).
lan_ip() {
  local ip
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -vE '^(127\.|100\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -n1)"
  fi
  printf '%s' "$ip"
}

usage() {
  cat <<EOF
smarthome – zarzadzanie serwerem Smart Home i wezlami ESP

  smarthome status                 Stan serwera (broker, uslugi, temp, siec, Tailscale)
  smarthome nodes                  Lista wezlow ESP i ich zdrowie (z monitora)
  smarthome cmd <kind> <komenda>   Komenda do wezla: reboot|reset_wifi|identify|diag|ping
  smarthome ota <kind> <plik|url>  Zdalny OTA: plik .bin (hostowany na Pi) lub gotowy URL
  smarthome set <topic> <payload>  Surowa publikacja MQTT (np. sterowanie aktuatorem)
  smarthome watch [topic]          Podglad ruchu MQTT (domyslnie home/#)
  smarthome wifi <...>             Siec Wi-Fi serwera (status|list|connect|forget|portal) – dziala offline
  smarthome logs [usluga]          Logi: monitor|wifi|lcd|health|broker (domyslnie monitor)
  smarthome broker <up|down|restart|logs>   Sterowanie kontenerem brokera
  smarthome update                 git pull + ponowny setup (aktualizacja serwera)
  smarthome tailscale [args...]    Przekazuje do 'tailscale' (np. 'smarthome tailscale status')

  kind = security | access | environment | system
EOF
}

cmd_status() {
  printf '%s== Smart Home – status ==%s\n' "$C_BOLD" "$C_RESET"
  printf 'Hostname        : %s (%s.local)\n' "$(hostname)" "${HOSTNAME:-rpi-smarthome}"

  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^mqtt_broker$'; then
    ok "Broker MQTT     : kontener UP"
  else
    err "Broker MQTT     : kontener NIE DZIALA"
  fi
  if nc -z localhost "$B_PORT" 2>/dev/null; then
    ok "Port $B_PORT      : nasluchuje"
  else
    err "Port $B_PORT      : brak odpowiedzi"
  fi

  for svc in smarthome-node-monitor smarthome-wifi-fallback smarthome-lcd avahi-daemon; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      printf '  %-26s %sactive%s\n' "$svc" "$C_GREEN" "$C_RESET"
    elif systemctl list-unit-files 2>/dev/null | grep -q "^$svc"; then
      printf '  %-26s %sinactive%s\n' "$svc" "$C_YELLOW" "$C_RESET"
    fi
  done

  if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
    local t; t="$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp)"
    printf 'Temp CPU        : %s C\n' "$t"
  fi
  printf 'Swap (zram)     : %s\n' "$(free -h 2>/dev/null | awk '/Swap/{print $3"/"$2}')"
  printf 'IP lokalne      : %s\n' "$(hostname -I 2>/dev/null | xargs)"
  if have tailscale; then
    printf 'Tailscale       : %s\n' "$(tailscale ip -4 2>/dev/null | head -n1 || echo 'niezalogowany')"
  fi

  if [ -r "$NODES_JSON" ] && have jq; then
    local on tot
    on="$(jq '[.nodes[]|select(.status=="online")]|length' "$NODES_JSON" 2>/dev/null || echo '?')"
    tot="$(jq '.nodes|length' "$NODES_JSON" 2>/dev/null || echo '?')"
    printf 'Wezly ESP       : %s/%s online (szczegoly: smarthome nodes)\n' "$on" "$tot"
  fi
}

cmd_nodes() {
  if [ ! -r "$NODES_JSON" ]; then
    warn "Brak $NODES_JSON – czy usluga smarthome-node-monitor dziala?"; return 1
  fi
  if ! have jq; then
    cat "$NODES_JSON"; return 0
  fi
  printf '%-14s %-9s %-9s %-8s %s\n' "KIND" "STATUS" "AVAIL" "DIAG_S" "ID"
  jq -r '.nodes | to_entries[] |
    "\(.key)\t\(.value.status // "-")\t\(.value.availability // "-")\t\(.value.diag_age_s // "-")\t\(.value.info.id // "-")"' \
    "$NODES_JSON" | while IFS=$'\t' read -r kind status avail age id; do
      printf '%-14s %-9s %-9s %-8s %s\n' "$kind" "$status" "$avail" "$age" "$id"
    done
  echo
  local srv; srv="$(jq -r '.server | "Serwer: temp=\(.cpu_temp_c)C  RAM=\(.mem_avail_mb)/\(.mem_total_mb)MB  ip=\(.ip)  ts=\(.tailscale_ip)"' "$NODES_JSON" 2>/dev/null)"
  [ -n "$srv" ] && echo "$srv"
}

cmd_cmd() {
  local kind="${1:-}" command="${2:-}"
  [ -z "$kind" ] || [ -z "$command" ] && die "Uzycie: smarthome cmd <kind> <reboot|reset_wifi|identify|diag|ping>"
  log "Wysylam '$command' do home/$kind/cmd"
  mq_pub -t "home/$kind/cmd" -m "$command"
  ok "Wyslano."
}

cmd_ota() {
  local kind="${1:-}" src="${2:-}"
  { [ -z "$kind" ] || [ -z "$src" ]; } && \
    die "Uzycie: smarthome ota <kind> <plik.bin | http://url/firmware.bin>"

  local url
  if [[ "$src" =~ ^https?:// ]]; then
    # Podano gotowy URL – publikujemy bez kopiowania (ESP pobiera HTTP-em).
    url="$src"
  else
    # Podano plik lokalny – hostujemy go na Pi i budujemy URL do pobrania przez ESP.
    [ -f "$src" ] || die "Plik nie istnieje: $src"
    local fw_dir="$STATE_DIR/firmware"
    local name; name="$(basename "$src")"
    local ip; ip="$(lan_ip)"
    [ -n "$ip" ] || die "Nie moge ustalic IP LAN serwera. Podaj URL recznie: smarthome ota $kind http://<ip>:${WEB_PORT:-8080}/firmware/$name"
    mkdir -p "$fw_dir" 2>/dev/null || true
    if ! cp -f "$src" "$fw_dir/$name" 2>/dev/null; then
      die "Brak praw zapisu do $fw_dir. Uruchom: sudo smarthome ota $kind $src (lub dodaj sie do grupy 'smarthome')."
    fi
    chmod 0644 "$fw_dir/$name" 2>/dev/null || true
    # ESP pobiera po IP (nie .local) – pewne dla klienta HTTP w firmware.
    url="http://${ip}:${WEB_PORT:-8080}/firmware/${name}"
    log "Hostuje firmware: $fw_dir/$name  ->  $url"
  fi

  log "Wysylam OTA do home/$kind/update : $url"
  mq_pub -t "home/$kind/update" -m "$url"
  ok "Wyslano. Sledz postep: smarthome logs broker  /  smarthome watch 'home/$kind/#'"
}

cmd_set() {
  local topic="${1:-}" payload="${2:-}"
  [ -z "$topic" ] && die "Uzycie: smarthome set <topic> <payload>"
  mq_pub -t "$topic" -m "$payload"
  ok "Opublikowano $topic = $payload"
}

cmd_watch() { mq_sub -v -t "${1:-home/#}"; }

cmd_logs() {
  case "${1:-monitor}" in
    monitor) journalctl -u smarthome-node-monitor -f ;;
    wifi)    journalctl -u smarthome-wifi-fallback -f ;;
    lcd)     journalctl -u smarthome-lcd -f ;;
    health)  journalctl -u smarthome-health -f ;;
    broker)  ( cd "$REPO_DIR" && compose logs -f mosquitto ) ;;
    *)       die "Nieznana usluga. Dostepne: monitor|wifi|lcd|health|broker" ;;
  esac
}

cmd_broker() {
  case "${1:-}" in
    up)      ( cd "$REPO_DIR" && compose up -d ) ;;
    down)    ( cd "$REPO_DIR" && compose down ) ;;
    restart) ( cd "$REPO_DIR" && compose restart mosquitto ) ;;
    logs)    ( cd "$REPO_DIR" && compose logs -f mosquitto ) ;;
    *)       die "Uzycie: smarthome broker <up|down|restart|logs>" ;;
  esac
}

# ==========================================================
# Wi-Fi serwera – rekonfiguracja/przepiecie sieci, dziala lokalnie (bez internetu).
# Operacje zmieniajace siec wymagaja root (nmcli). 'portal' wymusza AP konfiguracyjny
# na zadanie, nawet gdy serwer jest jeszcze polaczony (wspolpracuje z usluga
# smarthome-wifi-fallback przez plik-wyzwalacz $STATE_DIR/force_portal).
# ==========================================================
FORCE_PORTAL_FILE="$STATE_DIR/force_portal"
# Plik-zadanie z dashboardu (web pisze, rootowa usluga smarthome-wifi-apply wykonuje).
WIFI_REQUEST_FILE="$STATE_DIR/wifi_request"

_wifi_need_root() { [ "$(id -u)" -eq 0 ] || die "Ta operacja zmienia siec i wymaga root: poprzedz poleceniem 'sudo'."; }

# Zapisuje biezacy stan Wi-Fi do plikow tekstowych czytanych przez dashboard
# (bez JSON-a w bashu): aktywna siec + lista sieci w zasiegu.
_wifi_write_status() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  { nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null || true; } \
    | awk -F: '$2=="wlan0"{print $1; exit}' > "$STATE_DIR/wifi_current.txt" 2>/dev/null || true
  { nmcli -t -f SSID device wifi list 2>/dev/null || true; } \
    | awk 'NF && !seen[$0]++' > "$STATE_DIR/wifi_networks.txt" 2>/dev/null || true
}

cmd_wifi() {
  local action="${1:-status}"; shift || true
  # migrate-nm sam instaluje NetworkManagera (bootstrap), wiec NIE wymaga nmcli z gory.
  if [ "$action" != "migrate-nm" ]; then
    have nmcli || die "Brak nmcli. Najpierw zmigruj Wi-Fi: sudo smarthome wifi migrate-nm \"<SSID>\" \"<HASLO>\""
  fi
  case "$action" in
    status|"")
      printf '%s== Wi-Fi serwera ==%s\n' "$C_BOLD" "$C_RESET"
      { nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null || true; } | \
        awk -F: '$2=="wifi"||$2=="ethernet"{printf "  %-8s %-9s %-13s %s\n",$1,$2,$3,$4}'
      printf 'IP lokalne      : %s\n' "$(hostname -I 2>/dev/null | xargs)"
      printf 'Zapisane sieci  :\n'
      { nmcli -t -f NAME,TYPE connection show 2>/dev/null || true; } | awk -F: '$2 ~ /wireless/{print "  - "$1}'
      [ -e "$FORCE_PORTAL_FILE" ] && warn "Wymuszony portal jest AKTYWNY (wylacz: sudo smarthome wifi portal off)."
      ;;
    list|scan)
      nmcli device wifi rescan 2>/dev/null || true
      nmcli -f IN-USE,SSID,SIGNAL,SECURITY device wifi list
      ;;
    connect)
      local ssid="${1:-}" pass="${2:-}"
      [ -z "$ssid" ] && die "Uzycie: sudo smarthome wifi connect <ssid> [haslo]"
      _wifi_need_root
      warn "Przelaczam serwer na siec '$ssid'. Jesli laczysz sie po SSH przez te Wi-Fi, sesja moze zerwac."
      if [ -n "$pass" ]; then
        nmcli device wifi connect "$ssid" password "$pass"
      else
        nmcli device wifi connect "$ssid"
      fi
      rm -f "$FORCE_PORTAL_FILE" 2>/dev/null || true
      ok "Zlecono polaczenie z '$ssid'. Sprawdz: smarthome wifi status"
      ;;
    forget)
      local ssid="${1:-}"
      [ -z "$ssid" ] && die "Uzycie: sudo smarthome wifi forget <ssid>"
      _wifi_need_root
      nmcli connection delete "$ssid" && ok "Usunieto zapisana siec '$ssid'."
      ;;
    migrate-nm)
      _wifi_need_root
      local ssid="${1:-}" pass="${2:-}"
      [ -z "$ssid" ] && ssid="$(iwgetid -r 2>/dev/null || true)"
      [ -z "$ssid" ] && die "Uzycie: sudo smarthome wifi migrate-nm <SSID> <HASLO>  (podaj SWOJA siec)"
      warn "Przygotowuje przejscie Wi-Fi na NetworkManager. Zmiana wejdzie DOPIERO PO REBOOCIE."
      warn "NIE zrywa polaczenia teraz – ale po reboocie, jesli NM nie polaczy, Tailscale tez padnie."
      warn "MIEJ KONSOLE HDMI POD REKA przy pierwszym rebootcie."

      # 1. NetworkManager (instalator celowo go nie wgrywa – robimy to tu, swiadomie).
      if ! have nmcli; then
        log "Instaluje network-manager..."
        wait_for_apt
        DEBIAN_FRONTEND=noninteractive apt-get update -qq || true
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq network-manager || die "Instalacja network-manager nieudana."
      fi

      # 2. Profil NM zapisany OFFLINE (keyfile), BEZ uruchamiania NM teraz.
      #    Dzieki temu nie ma konfliktu o wlan0 z dzialajacym networkd – przelaczenie
      #    nastapi czysto przy reboocie, a NM polaczy z ta siecia z autoconnect.
      mkdir -p /etc/NetworkManager/system-connections
      local kf="/etc/NetworkManager/system-connections/${ssid}.nmconnection"
      local uuid; uuid="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo '')"
      {
        echo "[connection]"
        echo "id=${ssid}"
        [ -n "$uuid" ] && echo "uuid=${uuid}"
        echo "type=wifi"
        echo "interface-name=wlan0"
        echo "autoconnect=true"
        echo ""
        echo "[wifi]"
        echo "mode=infrastructure"
        echo "ssid=${ssid}"
        echo ""
        if [ -n "$pass" ]; then
          echo "[wifi-security]"
          echo "key-mgmt=wpa-psk"
          echo "psk=${pass}"
          echo ""
        fi
        echo "[ipv4]"
        echo "method=auto"
        echo ""
        echo "[ipv6]"
        echo "method=auto"
      } > "$kf"
      chmod 600 "$kf"
      log "Zapisano profil NM: $kf"

      # 3. Renderer netplan -> NM + wylaczenie zarzadzania siecia przez cloud-init,
      #    by po reboocie networkd NIE przejal wlan0 (to powodowalo stan 'unavailable').
      cat > /etc/netplan/99-networkmanager.yaml <<'NPEOF'
network:
  version: 2
  renderer: NetworkManager
NPEOF
      chmod 600 /etc/netplan/99-networkmanager.yaml
      mkdir -p /etc/cloud/cloud.cfg.d
      printf 'network: {config: disabled}\n' > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg

      # 4. Wygeneruj backendy (NIE 'apply' – zadnej zmiany na zywo, przelaczenie przy reboocie).
      netplan generate 2>/dev/null || true
      systemctl enable NetworkManager >/dev/null 2>&1 || true

      ok "Gotowe. System dziala dalej na networkd; przejscie na NM nastapi po restarcie."
      printf '\n    >>> ZRESTARTUJ PI:  sudo reboot  <<<\n\n'
      log "Po reboocie NM przejmie wlan0 i polaczy z '$ssid'. Potem: AP_FALLBACK_ENABLE=1 + 'sudo smarthome update'."
      warn "Powrot awaryjny (z konsoli, gdyby NM nie wstal): sudo rm /etc/netplan/99-networkmanager.yaml /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg && sudo netplan apply"
      ;;
    portal)
      _wifi_need_root
      if [ "${1:-}" = "off" ]; then
        rm -f "$FORCE_PORTAL_FILE" 2>/dev/null || true
        # Zdejmij AP, by NetworkManager wrocil do zapisanej sieci (autoconnect).
        nmcli connection down "${AP_SSID:-SmartHome-Config}" 2>/dev/null || true
        nmcli connection delete "${AP_SSID:-SmartHome-Config}" 2>/dev/null || true
        ok "Wymuszony portal wylaczony – serwer wraca do zapisanej sieci."
      else
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        : > "$FORCE_PORTAL_FILE"
        ok "Wymuszam portal Wi-Fi. Za chwile pojawi sie AP '${AP_SSID:-SmartHome-Config}'."
        log "Polacz telefon z tym AP i otworz http://10.42.0.1  (wylacz: sudo smarthome wifi portal off)"
      fi
      ;;
    scan)
      _wifi_need_root
      nmcli device wifi rescan 2>/dev/null || true
      sleep 2
      _wifi_write_status
      ok "Skan zapisany ($STATE_DIR/wifi_networks.txt)."
      ;;
    apply-request)
      # Wykonawca zadan z dashboardu. Czyta $WIFI_REQUEST_FILE (format klucz=wartosc),
      # wykonuje akcje przez nmcli i odswieza pliki stanu. Wolane przez root (usluga).
      _wifi_need_root
      if [ ! -f "$WIFI_REQUEST_FILE" ]; then _wifi_write_status; return 0; fi
      local a="" s="" p="" k v
      while IFS='=' read -r k v; do
        case "$k" in action) a="$v" ;; ssid) s="$v" ;; pass) p="$v" ;; esac
      done < "$WIFI_REQUEST_FILE"
      rm -f "$WIFI_REQUEST_FILE" 2>/dev/null || true
      log "Zadanie Wi-Fi z dashboardu: action=$a ssid=$s"
      case "$a" in
        connect)
          if [ -n "$s" ] && [ -n "$p" ]; then nmcli device wifi connect "$s" password "$p" || true
          elif [ -n "$s" ]; then nmcli device wifi connect "$s" || true; fi
          rm -f "$FORCE_PORTAL_FILE" 2>/dev/null || true ;;
        forget)      [ -n "$s" ] && { nmcli connection delete "$s" || true; } ;;
        portal)      : > "$FORCE_PORTAL_FILE" ;;
        portal-off)  rm -f "$FORCE_PORTAL_FILE" 2>/dev/null || true
                     nmcli connection down "${AP_SSID:-SmartHome-Config}" 2>/dev/null || true
                     nmcli connection delete "${AP_SSID:-SmartHome-Config}" 2>/dev/null || true ;;
        scan)        nmcli device wifi rescan 2>/dev/null || true; sleep 2 ;;
        *)           warn "Nieznana akcja Wi-Fi: $a" ;;
      esac
      _wifi_write_status
      ;;
    switch-all)
      # Przepina CALA makiete na nowa siec: najpierw rozsyla set_wifi do wszystkich
      # wezlow ESP (musza byc ONLINE), potem przelacza sam RPi. Wymaga firmware z
      # obsluga set_wifi i Wi-Fi pod NetworkManagerem.
      _wifi_need_root
      local nssid="${1:-}" npass="${2:-}"
      [ -z "$nssid" ] && die "Uzycie: sudo smarthome wifi switch-all <SSID> <HASLO>"
      case "$nssid$npass" in
        *'"'*|*'\'*) die "SSID/haslo nie moga zawierac znakow \" ani \\ (psuja JSON komendy).";;
      esac
      warn "Przepinam CALA makiete na siec '$nssid' (ESP-ki + RPi)."
      warn "Rob to PRZEZ TAILSCALE – przelaczenie RPi zerwie biezaca siec lokalna."
      local payload kinds kk
      payload="$(printf '{"cmd":"set_wifi","ssid":"%s","pass":"%s"}' "$nssid" "$npass")"
      IFS=',' read -ra kinds <<< "${EXPECTED_KINDS:-security,access,environment}"
      log "Rozsylam set_wifi do wezlow ESP (musza byc teraz online)..."
      for kk in "${kinds[@]}"; do
        kk="$(printf '%s' "$kk" | xargs)"
        [ -z "$kk" ] && continue
        log "  -> home/$kk/cmd"
        mq_pub -t "home/$kk/cmd" -m "$payload"
      done
      log "Czekam 6 s, az ESP-ki odbiora komende i zaczna restart na nowa siec..."
      sleep 6
      log "Przelaczam RPi na '$nssid'..."
      if nmcli device wifi connect "$nssid" password "$npass"; then
        ok "RPi przelaczony. Po ~1-2 min: 'smarthome nodes' (ESP-ki powinny wrocic na nowej sieci)."
      else
        warn "Przelaczenie RPi nieudane (sprawdz 'smarthome wifi status'). ESP-ki juz dostaly nowe dane."
      fi
      ;;
    *)
      die "Uzycie: smarthome wifi <status|list|connect <ssid> [haslo]|forget <ssid>|portal [off]|scan|switch-all <ssid> <haslo>|migrate-nm <ssid> <haslo>>"
      ;;
  esac
}

cmd_update() {
  [ "$(id -u)" -eq 0 ] || die "Aktualizacja wymaga sudo: sudo smarthome update"
  local status_file="$STATE_DIR/update_status.json"
  local before after changed=0 ok=1
  mkdir -p "$STATE_DIR" 2>/dev/null || true

  # Git jako root w repo nalezacym do innego usera -> unikamy "dubious ownership".
  git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true
  before="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  printf '{"state":"running","started":"%s","before":"%s"}\n' "$(date -Is)" "$before" \
    > "$status_file" 2>/dev/null || true

  log "Sprawdzam i pobieram zmiany ($REPO_DIR)..."
  # Model wezla wdrozeniowego: working tree = lustro origin. Twarde wyrownanie
  # (fetch + reset --hard) jest odporne na lokalny drift plikow na Pi (inaczej
  # 'pull' wywala sie na 'local changes would be overwritten'). Konfiguracja
  # uzytkownika nie jest w repo (siedzi w /etc/smarthome), wiec nic nie tracimy.
  local branch
  branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo develop)"
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then branch="${REPO_BRANCH:-develop}"; fi
  git -C "$REPO_DIR" fetch --prune origin || ok=0
  git -C "$REPO_DIR" reset --hard "origin/$branch" || ok=0
  after="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  [ "$before" != "$after" ] && changed=1
  [ "$changed" = "1" ] && log "Nowa wersja: $before -> $after" || log "Brak nowych zmian (wersja $after)."

  log "Uruchamiam ponownie setup..."
  bash "$SCRIPTS_DIR/setup.sh" || ok=0

  # Restart uslug aplikacyjnych, by zmiany w ich kodzie weszly w zycie (enable --now
  # samo nie restartuje juz dzialajacej uslugi). try-restart = tylko gdy aktywna.
  systemctl try-restart smarthome-node-monitor smarthome-wifi-fallback smarthome-lcd 2>/dev/null || true

  printf '{"state":"done","finished":"%s","before":"%s","after":"%s","changed":%s,"ok":%s}\n' \
    "$(date -Is)" "$before" "$after" "$changed" "$ok" > "$status_file" 2>/dev/null || true
  [ "$ok" = "1" ] && ok "Aktualizacja zakonczona." || die "Aktualizacja zakonczona z bledami (patrz wyzej)."
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status)    cmd_status "$@" ;;
    nodes)     cmd_nodes "$@" ;;
    cmd)       cmd_cmd "$@" ;;
    ota)       cmd_ota "$@" ;;
    set)       cmd_set "$@" ;;
    watch)     cmd_watch "$@" ;;
    wifi)      cmd_wifi "$@" ;;
    logs)      cmd_logs "$@" ;;
    broker)    cmd_broker "$@" ;;
    update)    cmd_update "$@" ;;
    tailscale) tailscale "$@" ;;
    ""|-h|--help|help) usage ;;
    *)         err "Nieznana komenda: $sub"; echo; usage; exit 1 ;;
  esac
}

main "$@"
