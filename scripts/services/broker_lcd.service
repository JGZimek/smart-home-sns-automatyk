[Unit]
Description=LCD Display Service for SmartHome Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smarthome
SupplementaryGroups=i2c
WorkingDirectory=/home/smarthome/smart-home-sns-automatyk/scripts
ExecStart=/home/smarthome/smart-home-sns-automatyk/scripts/venv/smarthome_env/bin/python /home/smarthome/smart-home-sns-automatyk/scripts/src/broker_lcd.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target